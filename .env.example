# Copy this file to .env and fill in your values.

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# WhatsApp Cloud API (from the Meta dashboard)
WHATSAPP_VERIFY_TOKEN=choose-any-string
WHATSAPP_ACCESS_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=1234567890
GRAPH_API_VERSION=v21.0
# App secret from Meta app dashboard -> App settings -> Basic. Used to verify
# the X-Hub-Signature-256 header on incoming webhooks. Leave empty only in dev.
WHATSAPP_APP_SECRET=

# Optional: notify this number on handoff (E.164 without the plus, e.g. 14155551234)
HUMAN_HANDOFF_NUMBER=

# Server
PORT=3000
